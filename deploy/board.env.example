# gremlinz board, production settings. Copy to ~/gremlinz-board.env on the server, chmod 600, fill in.
# Not in git. Every value single-quoted so the file can be sourced:  set -a; . ~/gremlinz-board.env; set +a
# scripts/prod-run.sh loads it on every deploy. Every variable: apps/board/README.md.

# Site
BOARD_PUBLIC_URL='https://gremlinz.ai'
# PORT='8790'

# Hatch on Fluence (on when the secret, image and public URL are set)
BOARD_HATCH_SECRET=''
BOARD_EGG_IMAGE='ghcr.io/dominant-strategies/gremlinz-egg@sha256:...'
# Dev phase: the team's SSH keys on every egg, comma-separated
BOARD_EGG_DEV_SSH_KEYS=''

# Gremlin Forge: Claude designs, cuts and special instructions (FORGE_DESIGN='off' to stop)
ANTHROPIC_API_KEY=''
# Forge photos: the first key present wins unless FORGE_PHOTO_PROVIDER picks one
# FAL_KEY=''
# GEMINI_API_KEY=''
# OPENAI_API_KEY=''

# Site build. Vite reads apps/launch/.env.production itself (VITE_EGG_IMAGE, VITE_EGG_DEV_SSH_KEYS; not in git);
# a VITE_* set here overrides it.
# VITE_EGG_MODEL_POLICY='1'   # model policy in configs; only once the egg image supports it
